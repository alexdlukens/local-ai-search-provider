[Desktop Entry]
Type=Application
Name=AI Chats
GenericName=AI Chat
Comment=Ask the local AI model and browse saved conversations
Exec="@GJS@" -m "@EXTENSION_DIR@/chatWindow.js"
Icon=org.gnome.Shell.Extensions.AiSearch.Chat
Terminal=false
Categories=Utility;GTK;
Keywords=AI;chat;history;
StartupWMClass=org.gnome.Shell.Extensions.AiSearch.Chat
